---
import { getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Prose from '@/components/Prose.astro';
import type { Lang } from '@/i18n';

const { lang } = Astro.props as { lang: Lang };
const isZh = lang === 'zh';

const entry = await getEntry('content', `${lang}/about`);
const { Content } = await render(entry!);

const pageTitle = isZh ? '关于 AI 智能抠图' : 'About AI Background Remover';
const secondTitle = isZh
  ? '免费、批量、无需登录、画质无损'
  : 'Free, Batch, No Login, No Quality Loss';
const title = isZh
  ? '关于 BgGone | 免费 AI 抠图工具'
  : 'About BgGone | Free AI Background Remover';
---

<BaseLayout
  lang={lang}
  pageTitle={pageTitle}
  secondTitle={secondTitle}
  title={title}
>
  <div class="mt-5 md:mt-8 px-4 main-width">
    <Prose>
      <Content />
    </Prose>
  </div>
</BaseLayout>
