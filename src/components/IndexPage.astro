---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import Prose from '@/components/Prose.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SelectImage from '@/components/SelectImage';
import type { Lang } from '@/i18n';
import car from '@/images/car.jpg';
import dog from '@/images/dog.jpg';
import eagle from '@/images/eagle.jpg';
import love from '@/images/love.jpg';
import motorcycle from '@/images/motorcycle.jpg';

const { lang } = Astro.props as { lang: Lang };
const isZh = lang === 'zh';

const exampleImgs = isZh
  ? [
      { src: car, alt: '去除背景后的汽车照片 | AI 抠图工具' },
      { src: dog, alt: '透明背景的宠物抠图 | AI 去背景' },
      { src: eagle, alt: '去除背景后的鹰 | AI 抠图工具' },
      { src: love, alt: '透明背景的人物抠图 | AI 去背景' },
      { src: motorcycle, alt: '去除背景后的摩托车 | AI 抠图工具' },
    ]
  : [
      { src: car, alt: 'Car photo with background removed | AI background remover' },
      { src: dog, alt: 'Pet cutout with transparent background | BgGone' },
      { src: eagle, alt: 'Eagle with background removed | AI background remover' },
      { src: love, alt: 'Person cutout with transparent background | BgGone' },
      { src: motorcycle, alt: 'Motorcycle with background removed | AI background remover' },
    ];

const pageTitle = isZh ? 'BgGone – AI 抠图工具' : 'BgGone – AI Background Remover';
const secondTitle = isZh
  ? '免费 · 批量 · 无需登录 · 无需上传 · 画质无损'
  : 'Free · Batch · No Login · No Upload · No Quality Loss';
const title = isZh
  ? 'BgGone – 免费 AI 抠图工具，无需登录、无需上传'
  : 'BgGone – Free AI Background Remover, No Login or Upload';

const entry = await getEntry('content', `${lang}/index`);
const { Content } = await render(entry!);

function extractFaq(body: string) {
  const faqs: { q: string; a: string }[] = [];
  let q = '';
  let buf: string[] = [];
  const flush = () => {
    const answer = buf.join(' ').replace(/\s+/g, ' ').trim();
    if (q && answer) faqs.push({ q: q.replace(/\*\*/g, '').trim(), a: answer });
  };
  for (const line of body.split('\n')) {
    if (line.startsWith('### ')) {
      flush();
      q = line.slice(4);
      buf = [];
    } else if (line.startsWith('## ')) {
      flush();
      q = '';
    } else if (q) {
      buf.push(line);
    }
  }
  flush();
  return faqs;
}

const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: extractFaq(entry!.body).map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
});
---

<BaseLayout
  lang={lang}
  pageTitle={pageTitle}
  secondTitle={secondTitle}
  title={title}
>
  <SelectImage lang={lang} client:load>
    {
      exampleImgs.map(({ src, alt }) => (
        <Image
          class="w-13 md:w-16 rounded-md cursor-pointer"
          src={src}
          alt={alt}
        />
      ))
    }
  </SelectImage>

  <div class="mt-5 md:mt-8 px-4 main-width">
    <Prose>
      <Content />
    </Prose>

    <script type="application/ld+json" set:html={faqJsonLd} />

    <div class="mt-4" id="back-to-top">
      <a class="cursor-pointer hover:underline"
        >{isZh ? '立即去除背景' : 'Remove Backgrounds Now'}</a
      >
    </div>
  </div>
</BaseLayout>

<script>
  const backToTopButton = document.getElementById('back-to-top');
  backToTopButton?.addEventListener('click', (e) => {
    e.preventDefault();
    window.scrollTo({
      top: 0,
      behavior: 'smooth',
    });
  });
</script>
