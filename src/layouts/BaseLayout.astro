---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import '../styles/global.css';

const { lang, pageTitle, secondTitle, title } = Astro.props;
const isZh = lang === 'zh';

const description = isZh
  ? 'BgGone（bgg.one）：免费、私密的 AI 抠图工具，完全在浏览器中运行。无需登录、无需上传，一键去除图片背景。'
  : 'BgGone (bgg.one): a free, private AI background remover that runs entirely in your browser. No login, no uploads — remove image backgrounds instantly.';

const pathname = Astro.url.pathname;
const unprefixed = pathname.startsWith('/zh')
  ? (pathname.replace(/^\/zh/, '') || '/')
  : pathname;
const enUrl = getAbsoluteLocaleUrl('en', unprefixed);
const zhUrl = getAbsoluteLocaleUrl('zh', unprefixed);
const canonical = isZh ? zhUrl : enUrl;
const ogImage = new URL('/bggone-bg-remover.jpg', Astro.site).href;
const ogImageAlt = isZh ? 'BgGone – 免费 AI 抠图工具' : 'BgGone – Free AI Background Remover';
const isHome = pathname === '/' || pathname === '/zh/';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'BgGone',
      url: 'https://bgg.one',
      logo: 'https://bgg.one/logo.png',
    },
    ...(isHome
      ? [
          {
            '@type': 'WebApplication',
            name: 'BgGone',
            url: 'https://bgg.one',
            description,
            applicationCategory: 'MultimediaApplication',
            operatingSystem: 'Any',
            browserRequirements: 'Requires a modern browser with WebAssembly support',
            inLanguage: ['en', 'zh'],
            offers: {
              '@type': 'Offer',
              price: '0',
              priceCurrency: 'USD',
            },
            featureList: [
              'AI background remover',
              'Batch background removal',
              'Runs entirely in the browser',
              'No uploads, privacy-first',
              'Free, no signup, no watermarks',
            ],
            image: ogImage,
          },
        ]
      : []),
  ],
};
---

<html lang={lang} data-lang={lang} class="font-display text-[16px]">
  <head>
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('bgg-lang');
        } catch (e) {}
        if (stored) return;
        var path = location.pathname;
        var onIndex = path === '/' || path === '/zh/';
        if (!onIndex) return;
        var nav = (navigator.language || '').toLowerCase();
        var prefersZh = nav.indexOf('zh') === 0;
        if (prefersZh && path !== '/zh/') {
          location.replace('/zh/');
        } else if (!prefersZh && path === '/zh/') {
          location.replace('/');
        }
      })();
    </script>
    <title>{title}</title>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1.0,maximum-scale=5.0,minimum-scale=1.0,viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#030712"
      media="(prefers-color-scheme: dark)"
    />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="zh" href={zhUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://www.google-analytics.com" />

    <!-- Open Graph (Facebook, LinkedIn, etc.) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="BgGone" />
    <meta property="og:locale" content={isZh ? 'zh_CN' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" type="image/png" href="/favicon_32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon_48x48.png" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon_96x96.png" sizes="96x96" />
    <link
      rel="icon"
      type="image/png"
      href="/favicon_114x114.png"
      sizes="114x114"
    />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body class="px-4 text-gray-950 dark:bg-gray-950 dark:text-white">
    <Header lang={lang} />
    <h1
      class="text-center py-6 sm:py-8 text-3xl font-bold sm:text-4xl md:text-5xl lg:text-6xl"
    >
      {pageTitle}
      <p class="mt-2 sm:mt-4 text-lg sm:text-xl md:text-2xl lg:text-3xl">
        {secondTitle}
      </p>
    </h1>
    <main>
      <slot />
    </main>
    <Footer />
    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-CZS9K7V64W"></script>
    <script src="../scripts/do.js" defer></script>
  </body>
</html>
